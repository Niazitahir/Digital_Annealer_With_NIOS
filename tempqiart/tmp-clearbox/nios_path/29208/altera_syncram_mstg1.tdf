FUNCTION altera_syncram_impl_3tn9 (address_a[10..0], address_b[10..0], clock0, data_a[9..0], data_b[9..0], wren_a, wren_b)
RETURNS ( q_a[9..0], q_b[9..0]);

--synthesis_resources = M20K 2 
SUBDESIGN altera_syncram_mstg1
( 
	address_a[10..0]	:	input;
	address_b[10..0]	:	input;
	clock0	:	input;
	data_a[9..0]	:	input;
	data_b[9..0]	:	input;
	q_a[9..0]	:	output;
	q_b[9..0]	:	output;
	wren_a	:	input;
	wren_b	:	input;
) 
VARIABLE 
	altera_syncram_impl1 : altera_syncram_impl_3tn9;

BEGIN 
	altera_syncram_impl1.address_a[] = address_a[];
	altera_syncram_impl1.address_b[] = address_b[];
	altera_syncram_impl1.clock0 = clock0;
	altera_syncram_impl1.data_a[] = data_a[];
	altera_syncram_impl1.data_b[] = data_b[];
	altera_syncram_impl1.wren_a = wren_a;
	altera_syncram_impl1.wren_b = wren_b;
	q_a[] = altera_syncram_impl1.q_a[];
	q_b[] = altera_syncram_impl1.q_b[];
END;
