	component initial_h_rom is
		port (
			q       : out std_logic_vector(27 downto 0);                    -- dataout
			address : in  std_logic_vector(10 downto 0) := (others => 'X'); -- address
			clock   : in  std_logic                     := 'X'              -- clk
		);
	end component initial_h_rom;

